# ============================================================
# Baba Ideology - Exemplo de variaveis de ambiente
# Copie para a raiz do projeto ou para apps/api/.env e preencha os valores
# ============================================================

# --- Servidor ---
PORT=3333
NODE_ENV=development
# Origem permitida para CORS (frontend). Multiplas separadas por virgula.
CORS_ORIGIN=http://localhost:5173

# --- Banco de dados (PostgreSQL + pgvector) ---
# Local: suba o Postgres com Docker (`pnpm db:up`) e use a URL abaixo.
# Producao (Railway): crie um servico PostgreSQL separado no Railway;
# o painel injeta DATABASE_URL automaticamente no servico da API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baba

# --- Providers de IA ---
# Provider ativo para geracao de respostas: openai | gemini | claude
LLM_PROVIDER=openai
# Provider ativo para embeddings: openai
EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (opcionais, tem defaults sensatos por provider)
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_LLM_MODEL=gemini-1.5-flash
CLAUDE_LLM_MODEL=claude-3-haiku-20240307

# --- RAG ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_MIN_CHUNKS=5
RETRIEVAL_MAX_CHUNKS=10
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_TEXT_WEIGHT=0.3
RERANK_ENABLED=false

# Limite de tokens na resposta do LLM (respostas objetivas, menor custo)
LLM_MAX_OUTPUT_TOKENS=400

# --- Cache inteligente ---
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92

# --- Rate limiting por IP ---
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=86400

# --- Administracao ---
ADMIN_PASSWORD=troque-esta-senha

# --- Retencao de conversas (dias) ---
CONVERSATION_RETENTION_DAYS=30
